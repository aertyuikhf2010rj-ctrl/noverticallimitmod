{
  "schemaVersion": 1,
  "id": "nolimitpitch",
  "version": "${version}",
  "name": "No Limit Pitch",
  "description": "Remove o limite vertical (-90/+90) da câmera em primeira pessoa, permitindo giro vertical ilimitado, passando de 360/-360 quantas vezes quiser.",
  "authors": [
    "Você"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.exemplo.nolimitpitch.NoLimitPitchClient"
    ]
  },
  "mixins": [
    "nolimitpitch.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
